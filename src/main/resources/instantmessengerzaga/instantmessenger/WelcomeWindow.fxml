<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="instantmessengerzaga.instantmessenger.WelcomeController"
      alignment="CENTER"
      spacing="0"
      prefWidth="420" prefHeight="360">

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Card -->
    <VBox styleClass="welcome-card" alignment="CENTER" spacing="12">
        <Label text="InstantMessenger" styleClass="app-title"/>
        <Label text="A simple, fast chat application" styleClass="subtitle"/>

        <Region prefHeight="20"/>

        <Button text="Host a Server"
                onAction="#startServer"
                styleClass="primary-button, big-button"
                maxWidth="Infinity"/>

        <Button text="Join a Chat"
                onAction="#joinChat"
                styleClass="secondary-button, big-button"
                maxWidth="Infinity"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER">
        <padding><Insets bottom="16"/></padding>
        <Label text="InstantMessenger v1" styleClass="subtitle"/>
    </HBox>

</VBox>
