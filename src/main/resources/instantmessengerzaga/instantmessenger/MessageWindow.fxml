<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="instantmessengerzaga.instantmessenger.MessengerController"
      prefWidth="580" prefHeight="660">

    <!-- Header bar -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="Chat Room" styleClass="header-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="usernameLabel" styleClass="header-sub"/>
    </HBox>

    <!-- Message area (fills remaining space) -->
    <TextArea fx:id="messageArea"
              editable="false"
              wrapText="true"
              styleClass="message-area"
              VBox.vgrow="ALWAYS"/>

    <!-- Input row pinned to bottom -->
    <HBox styleClass="input-row" spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="textField"
                   promptText="Type a message and press Enter or Send..."
                   styleClass="input-field"
                   HBox.hgrow="ALWAYS"/>
        <Button text="Send"
                onAction="#sendMessage"
                styleClass="primary-button"/>
    </HBox>

</VBox>

